<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron/V8 requirements -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required to load native .node addons (sherpa-onnx) and bundled dylibs -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Permission to ASK for the microphone. Without this the prompt never appears. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- Permission to send Apple Events to other apps (AppleScript control) -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- NOTE: com.apple.security.app-sandbox is deliberately ABSENT.
       App Sandbox and the Accessibility (AX) grant are mutually exclusive:
       AXIsProcessTrustedWithOptions always returns false under the sandbox. -->
</dict>
</plist>
